# R.E.S.C.S. environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required. Arbitrary string used to authenticate API requests
# (minimum 16 characters). All API requests must present this key
# via the `X-API-Key` header.
RESCS_API_KEY=replace-with-a-long-random-key

# Optional. When set, locks every request to this single owner: writes must
# claim this owner and reads of other owners are rejected (single-tenant mode).
# Leave unset for multi-owner operation where callers supply `owner` freely.
# RESCS_API_KEY_OWNER=my-tenant

# Runtime environment: development | test | production
RESCS_ENV=development

# SQLAlchemy database URL. Defaults to a local SQLite file.
# For PostgreSQL / Supabase use e.g.:
# RESCS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
RESCS_DATABASE_URL=sqlite:///rescs_dev.db

# Create/update database tables on startup (true in dev/test, false in prod
# when a migration tool manages the schema).
RESCS_AUTO_CREATE_SCHEMA=true

# Directory used by the local file object store.
RESCS_STORAGE_DIR=rescs_storage

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
RESCS_LOG_LEVEL=INFO

# Request correlation header name. Every response echoes the request id under
# this header (caller-supplied ids up to 128 chars are honoured, otherwise
# generated). Defaults to X-Request-ID.
# RESCS_REQUEST_ID_HEADER=X-Request-ID

# v0.2 resource governance. Zero means "unlimited" (the default).
# Per-owner record/file/byte quotas (deleted and expired resources do not count).
# RESCS_MAX_RECORDS_PER_OWNER=0
# RESCS_MAX_FILES_PER_OWNER=0
# RESCS_MAX_BYTES_PER_OWNER=0
# Maximum accepted file size in bytes (0 = unlimited).
# RESCS_MAX_FILE_SIZE=0
# Maximum serialized metadata size in bytes.
# RESCS_MAX_METADATA_BYTES=65536
# Maximum operations per bulk request (1-1000).
# RESCS_MAX_BULK_BATCH=100
# Audit events older than this many days are pruned by admin cleanup (0 = keep).
# RESCS_AUDIT_RETENTION_DAYS=90
# Maximum accepted TTL in seconds (0 = unlimited, default 365 days).
# RESCS_MAX_TTL_SECONDS=31536000
# Payloads at/above this size stream instead of buffering fully in memory.
# RESCS_STREAMING_THRESHOLD_BYTES=8388608

# Object-store backend: local (default), memory, or s3.
# RESCS_STORAGE_BACKEND=local
# RESCS_S3_ENDPOINT=
# RESCS_S3_BUCKET=
# RESCS_S3_REGION=
# RESCS_S3_ACCESS_KEY=
# RESCS_S3_SECRET_KEY=
# RESCS_S3_PATH_PREFIX=

# Rate limiting (in-memory, single-instance). Disabled by default.
# RESCS_RATE_LIMIT_ENABLED=false
# RESCS_RATE_LIMIT_GENERAL_PER_MINUTE=100
# RESCS_RATE_LIMIT_WRITES_PER_MINUTE=60
# RESCS_RATE_LIMIT_UPLOADS_PER_MINUTE=20