# R.E.S.C.S. environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required. Arbitrary string used to authenticate API requests
# (minimum 16 characters). All API requests must present this key
# via the `X-API-Key` header.
RESCS_API_KEY=replace-with-a-long-random-key

# Runtime environment: development | test | production
RESCS_ENV=development

# SQLAlchemy database URL. Defaults to a local SQLite file.
# For PostgreSQL / Supabase use e.g.:
# RESCS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
RESCS_DATABASE_URL=sqlite:///rescs_dev.db

# Create/update database tables on startup (true in dev/test, false in prod
# when a migration tool manages the schema).
RESCS_AUTO_CREATE_SCHEMA=true

# Directory used by the local file object store.
RESCS_STORAGE_DIR=rescs_storage

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
RESCS_LOG_LEVEL=INFO